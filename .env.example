# Backend-only. DEMO remains public without these services.
DATABASE_URL=
APP_ORIGIN=
BETTER_AUTH_SECRET=
# 32 cryptographically random bytes, standard base64. Separate Vercel Secret.
CREDENTIALS_ENCRYPTION_KEY=
# Administrator-controlled suffixes; never a form field.
EXNESS_ALLOWED_HOSTS=exness.com,exness-api.com
PORT=3001

# Public Firebase Web app configuration (not Admin/service-account credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
