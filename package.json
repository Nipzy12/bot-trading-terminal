{
  "name": "bot-trading-terminal",
  "version": "1.0.0",
  "description": "Professional simulation-first trading terminal with a server-side market data bridge",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start:api": "tsx server/index.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "format": "prettier --write src server tests scripts vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nipzy12/bot-trading-terminal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Nipzy12/bot-trading-terminal/issues"
  },
  "homepage": "https://github.com/Nipzy12/bot-trading-terminal#readme",
  "dependencies": {
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
